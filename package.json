{
  "name": "jaldee-business-ui",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "turbo run clean",
    "dev": "turbo run dev --concurrency=12",
    "build": "turbo run build --concurrency=4",
    "preview": "turbo run preview",
    "serve": "turbo run serve",
    "check:finance-lines": "node scripts/check-finance-component-size.mjs",
    "automation:enterprise": "node automation/run-enterprise-automation.js",
    "automation:it-company": "node automation/run-it-company-automation.js",
    "automation:leads": "playwright test automation/e2e/specs/demo-flow.spec.ts --config automation/playwright.leads.config.ts",
    "automation:leads:headless": "set LEADS_HEADLESS=1&& playwright test automation/e2e/specs/demo-flow.spec.ts --config automation/playwright.leads.config.ts",
    "automation:leads:report": "playwright show-report automation/reports/leads",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "overrides": {
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "turbo": "^2.8.20"
  }
}
